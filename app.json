{
  "expo": {
    "name": "GoNext",
    "slug": "gonext",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gonext",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gonext.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото для дневника путешествий.",
          "cameraPermission": "Приложению нужна камера, чтобы снимать места в поездке."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Координаты нужны, чтобы подставить текущее место на карте."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6cd36a45-354d-4aa5-add9-2f33a2114f0c"
      }
    },
    "owner": "alzhprogs"
  }
}
